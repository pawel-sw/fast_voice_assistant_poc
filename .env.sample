# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the SAME value on the microphone client and inference server.
JARVIS_REMOTE_TOKEN=
NEEDLE_TELEMETRY=0

# Client only: choose an openHAB API token OR user/password authentication.
OPENHAB_TOKEN=
OPENHAB_USER=
OPENHAB_PASSWORD=

# Optional for the standalone inference client; the assistant uses config.json.
INFERENCE_URL=ws://inference.example.invalid:8765

# Server only (default binds all interfaces):
# JARVIS_PORT=8765

# Optional SSH tools: set these in your shell, not in source control.
# VM_SSH_HOST=inference.example.invalid
# VM_SSH_USER=home-assistant
# VM_SSH_PASSWORD=
# VM_PROJECT_DIR=/p/home_assistant

# Client only: Home Assistant long-lived access token.
HOMEASSISTANT_TOKEN=
