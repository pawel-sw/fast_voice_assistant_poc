[Unit]
Description=R2T2 and Kokoro Wyoming voice services for Home Assistant
After=network-online.target jarvis-vm.service
Wants=network-online.target jarvis-vm.service

[Service]
Type=simple
User=home-assistant
WorkingDirectory=/p/home_assistant
EnvironmentFile=/p/home_assistant/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/p/home_assistant/.venv/bin/python -m jarvis.wyoming
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
